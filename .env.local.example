# ================= SALIN JADI .env.local, LALU ISI =================
# URL aplikasi (untuk tautan reset password di email)
APP_URL=https://crm-aston.vercel.app

# ---- Super admin (login utama) ----
ADMIN_EMAIL=syam.rakhmany@gmail.com
ADMIN_NAME=Bang Syam
# hash bcrypt dari password Anda (cara buat ada di README)
ADMIN_PASSWORD_HASH=GANTI_DENGAN_HASH_BCRYPT

# ---- Firebase Admin (dari file serviceAccountKey.json) ----
FIREBASE_PROJECT_ID=nama-project-anda
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@nama-project.iam.gserviceaccount.com
# private_key DISALIN 1 BARIS; ganti setiap baris baru dengan \n dan bungkus tanda kutip
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_KUNCI\n-----END PRIVATE KEY-----\n"

# ---- Upload foto ke Google Drive (Apps Script kecil, lihat folder apps-script-upload) ----
DRIVE_UPLOAD_URL=https://script.google.com/macros/s/XXXX/exec

# ---- Email pengirim reset password (Gmail App Password) ----
MAIL_USER=emailanda@gmail.com
MAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
